# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
# Production URL (used for canonical URLs, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─────────────────────────────────────────────────────────────
# Project inquiry form — pick ONE delivery option.
# Without any of these, submissions are logged to the console in
# development and return "temporarily unavailable" in production.
# ─────────────────────────────────────────────────────────────

# Optional: post the form straight from the browser to a hosted endpoint
# (e.g. https://formspree.io/f/xxxxxxx). Skips the built-in /api/inquiry route.
# NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Force a provider: webhook | formspree | hubspot | resend | supabase | none
# (otherwise inferred from the variables below).
# INQUIRY_PROVIDER=

# Generic webhook — GoHighLevel inbound webhook, Zapier, Make, n8n,
# a Supabase Edge Function, or your own API. Receives JSON.
# INQUIRY_WEBHOOK_URL=
# INQUIRY_WEBHOOK_SECRET=

# Formspree (server-side forwarding, attachments included)
# FORMSPREE_FORM_ID=

# HubSpot Forms API
# HUBSPOT_PORTAL_ID=
# HUBSPOT_FORM_ID=

# Resend email notification (attachments included)
# RESEND_API_KEY=
# INQUIRY_EMAIL_TO=office@example.com
# INQUIRY_EMAIL_FROM="Crate Construction Website <website@yourdomain.com>"

# Supabase (row insert via REST; create the table first)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_INQUIRY_TABLE=inquiries
